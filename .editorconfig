root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

# C# naming conventions
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.types_and_methods_pascal_case.severity = error
dotnet_naming_rule.types_and_methods_pascal_case.symbols = types_and_methods
dotnet_naming_rule.types_and_methods_pascal_case.style = pascal_case
dotnet_naming_rule.private_fields_underscore_camel.severity = suggestion
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_symbols.types_and_methods.applicable_kinds = class,struct,enum,method,property,event
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Avoid unused usings; keep file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
