<Window x:Class="DynamicIsland.App.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" Height="52"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#CC1C1C1E" CornerRadius="26">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,14,0">
            <TextBlock Text="{Binding Title}" Foreground="AliceBlue" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="110"></TextBlock>
            <TextBlock Text="-" Foreground="AliceBlue" FontSize="10"></TextBlock>
            <TextBlock Text="{Binding Artist}" Foreground="AliceBlue" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="60"></TextBlock>
        </StackPanel>
    </Border>
</Window>
